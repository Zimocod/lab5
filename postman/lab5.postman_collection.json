    {
      "name": "03. GET із http.cat",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200]);",
              "});",
              "pm.test(\"Content-Type\", function () {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"image/jpeg\");",
              "});",
              "pm.test(\"Джерело картинки\", function () {",
              "  pm.expect(pm.response.headers.get(\"X-Image-Source\")).to.eql(\"http.cat\");",
              "});",
              "pm.collectionVariables.set(\"remoteTimeMs\", pm.response.responseTime);",
              "console.log(\"GET http.cat, ms:\", pm.response.responseTime);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/200",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "200"
          ]
        },
        "description": "Очікується HTTP 200, image/jpeg, X-Image-Source: http.cat."
      },
      "response": []
